# Choose exactly one provider: rapidapi or apify
PROVIDER=apify

# RapidAPI mode
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=your-rapidapi-host-here
RAPIDAPI_BASE_URL=https://linkedin-posts-search.p.rapidapi.com

# Apify mode
APIFY_TOKEN=your_apify_token_here
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_ACTOR_ID=sandhive/linkedin-posts-parser

# Runtime
HTTP_TIMEOUT_MS=30000
DEBUG=false
